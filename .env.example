# Copy this file to .env and fill in your own Alpaca market data credentials.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Generate locally; never reuse this placeholder
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
# Optional private paths
# LAB_DB_PATH=/private/path/db.sqlite3
# LAB_DATA_DIR=/private/path/artifacts
# LAB_WORKER_IMAGE=portfolio-lab-worker:0.2
LAB_OPERATOR_USERNAME=
